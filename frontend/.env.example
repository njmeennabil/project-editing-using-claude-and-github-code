# Address of the BUMI360 Flask API (no trailing slash).
# Local: http://localhost:5000   Production: your Render URL, e.g. https://bumi360-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:5000

# Free CARTO basemap key (https://carto.com/basemaps). Without it the map uses greyscale
# OpenStreetMap tiles. The key is visible in the browser, as with any map tile key.
NEXT_PUBLIC_CARTO_KEY=
